# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg://finplat:finplat@localhost:5432/finplat
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# Active gateway provider. Get a free key (no credit card) at
# https://console.groq.com/keys — required for the /ai/* endpoints, not for
# the rest of the app.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Inactive reference adapters — not required, kept for a future provider swap.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

CEREBRAS_API_KEY=your-cerebras-api-key-here
CEREBRAS_MODEL=gpt-oss-120b

# Neo4j (V0.3 graph-based detection). Local install default is
# bolt://localhost:7687; set NEO4J_PASSWORD to whatever you set via
# `ALTER CURRENT USER SET PASSWORD ...` (or neo4j-admin) after install —
# never commit a real value here.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j
